# Use the SAME Supabase project as backend/.env.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only destination for the /api proxy. No trailing /api.
GROWTHOS_BACKEND_URL=http://127.0.0.1:4000
# Leave NEXT_PUBLIC_API_BASE_URL unset: the browser calls same-origin /api.
# Never put database, AI, Sift, Apify or service-role credentials here.
