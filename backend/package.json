{
  "name": "growthos-backend",
  "private": true,
  "type": "module",
  "description": "GrowthOS V1 backend API (business logic, database, auth, task orchestration)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node server.js",
    "test": "vitest run",
    "worker": "node --env-file=.env ai/worker.js",
    "worker:production": "node ai/worker.js",
    "worker:once": "node --env-file=.env ai/worker.js --once",
    "test:ai": "vitest run --config vitest.ai.config.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "vitest": "^2.1.0"
  }
}
