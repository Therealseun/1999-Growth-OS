# Existing team database mode. Keep shared. Worker stays idle until configured.
GROWTHOS_SCHEMA=shared
AI_WORKER_ENABLED=false

# Main backend. These remain server-only.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres
DATABASE_SSL=verify
DATABASE_POOL_MAX=5
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
CRON_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Existing AI access must supply a compatible server API, model and credentials.
# No provider subscription or credits are assumed. Disabled until configured.
AI_ENABLED=false
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=json_schema
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_ITEMS_PER_JOB=10000
AI_QUALIFY_PROSPECTS=false
AI_WORKER_INTERVAL_MS=2000

# Sift is primary. Its team must provision service authentication on their API.
RESEARCH_PROVIDER=sift
# Enable only when the configured Apify tasks and spending cap are approved.
RESEARCH_FALLBACK=none
SIFT_ENABLED=false
SIFT_BASE_URL=
SIFT_API_KEY=
SIFT_AUTH_HEADER=Authorization
SIFT_OWNER_EMAIL=
# explicit: GrowthOS calls rephrase and run-resolve. background: Sift starts work on create.
SIFT_EXECUTION_MODE=explicit
SIFT_TIMEOUT_MS=30000
SIFT_JOB_TIMEOUT_MS=600000
SIFT_BATCH_SIZE=100
SIFT_MAX_JOBS_PER_REQUEST=3
APIFY_ENABLED=false
APIFY_TOKEN=
APIFY_CONFIG_FILE=./config/apify.json
APIFY_MAX_CHARGE_USD=0
APIFY_TIMEOUT_SECONDS=300
