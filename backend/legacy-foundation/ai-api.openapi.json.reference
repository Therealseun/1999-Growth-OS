  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "required": [
          "id",
          "campaign_id",
          "kind",
          "status",
          "requested_count",
          "delivered_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "campaign_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "NICHE_ANALYSIS",
              "PROSPECT_SEARCH",
              "EMAIL_GENERATION",
              "SEO_GENERATION",
              "LEAD_MAGNET_GENERATION"
            ]
          },
          "status": {
            "enum": [
              "REQUESTED",
              "ACCEPTED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "workload_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested_count": {
            "type": "integer"
          },
          "delivered_count": {
            "type": "integer"
          },
          "research_provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "external_job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_run_at": {
            "type": "string"
          },
          "summary": {
            "type": [
              "object",
              "null"
            ]
          },
          "active_research_provider": {
            "type": "string",
            "enum": [
              "sift",
              "apify"
            ],
            "description": "Provider currently executing; research_provider retains the requested primary provider."
          },
          "research_runs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Prior search run IDs and outcomes; no credentials or prospect records."
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "idempotency_key"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "NICHE_ANALYSIS",
              "PROSPECT_SEARCH",
              "EMAIL_GENERATION",
              "SEO_GENERATION",
              "LEAD_MAGNET_GENERATION"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "workload_id": {
            "type": "string",
            "format": "uuid"
          },
          "requested_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Research import count only; generation derives counts from workload_id."
          },
          "research_provider": {
            "type": "string",
            "enum": [
              "sift",
              "apify"
            ]
          },
          "messaging_constraints": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "approved_platforms": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "opportunities": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/Opportunity"
            }
          }
        }
      },
      "NicheProfile": {
        "type": "object",
        "properties": {
          "industry": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "organisation_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_makers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "job_titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "geographic_segments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pain_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buying_motivations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
