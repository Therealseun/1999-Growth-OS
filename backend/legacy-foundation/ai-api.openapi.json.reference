                    ]
                  },
                  "messaging_constraints": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string"
                    }
                  },
                  "approved_platforms": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string"
                    }
                  },
                  "opportunities": {
                    "type": "array",
                    "maxItems": 10000,
